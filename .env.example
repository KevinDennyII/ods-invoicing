# Key names only. Values live in Infisical at path /ods-invoicing (env: dev).
# Nothing here is loaded automatically; run commands through Infisical instead:
#
#   INFISICAL_DOMAIN=https://secrets.thatdeveloper.dev \
#   infisical run --env=dev --path=/ods-invoicing -- docker compose up -d

# --- Cloudflare Tunnel ---------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# --- Invoice Ninja application ------------------------------------------
APP_URL=
APP_KEY=
APP_ENV=
APP_DEBUG=
REQUIRE_HTTPS=
SESSION_SECURE_COOKIE=
TRUSTED_PROXIES=

# --- Database ------------------------------------------------------------
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- First boot only (delete from Infisical after the admin user exists) --
IN_USER_EMAIL=
IN_PASSWORD=

# --- Outbound mail -------------------------------------------------------
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# --- Client portal (BFF) -------------------------------------------------
# PORTAL_ORIGIN stays https://pay.ohhdennyservices.com for Netlify and Docker.
# NINJA_API_TOKEN: create after first admin boot (or set "pending" until then).
PORTAL_ORIGIN=
NINJA_API_TOKEN=
BFF_SESSION_SECRET=
